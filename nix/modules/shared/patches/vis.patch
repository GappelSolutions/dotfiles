+/* a program given the terminal gets the normal screen, as curses' endwin() does: switching to
+ * and from the alternate screen itself would otherwise leave vis drawing on the normal one.
+ * Both switches are synchronized updates, so the normal screen doesn't flash in between: the
+ * program's first synchronized frame ends the first (lazygit, yazi and tv have them); for one
+ * without (less, scooter) a timer does, as zellij would hold the screen for good, set past
+ * lazygit's ~330 ms startup. vis' next frame ends the second */
+static bool screen_handed_over;
+
+static void sync_end(int sig) {
+	static const char end[] = "\x1b[?2026l";
+	int err = errno;
+	while (write(STDERR_FILENO, end, sizeof end - 1) == -1 && errno == EINTR);
+	errno = err;
+}
+
 static void ui_vt100_save(UiTerm *tui, bool fscr) {
+	if (fscr) {
+		sigaction(SIGALRM, &(struct sigaction){ .sa_handler = sync_end, .sa_flags = SA_RESTART }, NULL);
+		output_literal("\x1b[?2026h");
+		screen_alternate(false);
+		screen_handed_over = true;
+		setitimer(ITIMER_REAL, &(struct itimerval){ .it_value = { .tv_usec = 500000 } }, NULL);
+	}
+	mouse_reporting(false);
 	cursor_visible(true);
 }
 
 static void ui_vt100_restore(UiTerm *tui) {
+	if (screen_handed_over) {
+		setitimer(ITIMER_REAL, &(struct itimerval){ 0 }, NULL);
+		output_literal("\x1b[?2026h");
+		screen_alternate(true);
+		screen_handed_over = false;
+	}
+	mouse_reporting(true);
 	cursor_visible(false);
 }
 
