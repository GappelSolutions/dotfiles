+/* the window at screen cell x, y and the text cell there: row -1 on its status bar, col 0 on
+ * its line numbers */
+static Win *ui_window_at(Ui *ui, int x, int y, int *row, int *col) {
+	UiTerm *tui = (UiTerm*)ui;
+	for (UiTermWin *win = tui->windows; win; win = win->next) {
+		if (x < win->x || x >= win->x + win->width || y < win->y || y >= win->y + win->height)
+			continue;
+		bool status = (win->options & UI_OPTION_STATUSBAR) && y == win->y + win->height - 1;
+		*row = status ? -1 : y - win->y;
+		*col = MAX(x - win->x - win->sidebar_width, 0);
+		return win->win;
+	}
+	return NULL;
+}
