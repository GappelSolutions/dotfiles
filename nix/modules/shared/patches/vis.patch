+/* as nvim's mouse=a: a click focuses the window under it and puts its only cursor there,
+ * ending visual mode, a drag from it selects in visual mode, the wheel scrolls the window
+ * under it 3 lines. Not while a prompt (:, /) is open */
+static void mouse(Vis *vis, const TermKeyKey *key) {
+	static bool pressed; /* in the focused window's text, so a drag selects */
+	TermKeyMouseEvent event;
+	int button, line, col, row, cell;
+	termkey_interpret_mouse(vis->ui->termkey_get(vis->ui), key, &event, &button, &line, &col);
+	Win *win = vis->ui->window_at(vis->ui, col - 1, line - 1, &row, &cell);
+	if (event == TERMKEY_MOUSE_RELEASE)
+		pressed = false;
+	if (event == TERMKEY_MOUSE_RELEASE || !win || !vis->win || vis->win->parent)
+		return;
+	View *view = win->view;
+	if (event == TERMKEY_MOUSE_PRESS && (button == 4 || button == 5)) {
+		if (button == 4)
+			view_slide_down(view, 3);
+		else
+			view_slide_up(view, 3);
+		return;
+	}
+	if (button != 1 || (event == TERMKEY_MOUSE_DRAG && (!pressed || win != vis->win)))
+		return;
+	if (event == TERMKEY_MOUSE_PRESS) {
+		pressed = row >= 0;
+		if (win != vis->win)
+			vis_window_focus(win);
+		if (vis->mode->visual)
+			vis_mode_switch(vis, VIS_MODE_NORMAL);
+		view_selections_dispose_all(view);
+		if (!pressed)
+			return;
+	} else if (!vis->mode->visual) {
+		vis_mode_switch(vis, VIS_MODE_VISUAL);
+	}
+	if (row < 0)
+		return;
+	Selection *sel = view_selections_primary_get(view);
+	view_cursors_to(sel, view_screenline_goto(view, row + 1));
+	view_cursors_cell_set(sel, cell);
+}
