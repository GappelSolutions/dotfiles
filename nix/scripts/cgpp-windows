set -euo pipefail

APP=${0##*/}
HOME_DIR=${HOME_DIR:-"$HOME"}
TARGET_ROOT=""
USB=0
OPEN_RDP=1

usage() {
  cat <<'EOF'
Usage:
  cgpp-windows tui
  cgpp-windows restore --image PATH [--target-root /mnt]
  cgpp-windows start [--usb] [--no-rdp]
  cgpp-windows stop
  cgpp-windows status
  cgpp-windows logs

Restore rules:
  - data.img is copied or hard-linked as a real file, never a symlink.
  - windows.boot is created so Dockur boots the image instead of reinstalling.
EOF
}

die() {
  printf '%s: %s\n' "$APP" "$*" >&2
  exit 1
}

log() {
  printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

as_user() {
  if [ "$(id -u)" = 0 ] && id cgpp >/dev/null 2>&1; then
    runuser -u cgpp -- "$@"
  else
    "$@"
  fi
}

parse_common() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --target-root)
        TARGET_ROOT=${2:-}
        [ -n "$TARGET_ROOT" ] || die "--target-root needs a path"
        shift 2
        ;;
      --usb)
        USB=1
        shift
        ;;
      --no-rdp)
        OPEN_RDP=0
        shift
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
  done
}

target_home() {
  if [ -n "$TARGET_ROOT" ]; then
    printf '%s/home/cgpp\n' "$TARGET_ROOT"
  else
    printf '%s\n' "$HOME_DIR"
  fi
}

ensure_config() {
  local home_dir windows_config
  home_dir=$(target_home)
  windows_config="$home_dir/.config/windows"

  install -d -m 0700 "$windows_config"
  install -d -m 0755 "$home_dir/.windows"
  install -d -m 0777 "$home_dir/Windows"

  if [ ! -e "$windows_config/docker-compose.yml" ]; then
    cat >"$windows_config/docker-compose.yml" <<'EOF'
services:
  windows:
    image: dockurr/windows
    container_name: nix-windows
    environment:
      VERSION: "11"
      RAM_SIZE: "8G"
      CPU_CORES: "2"
      DISK_SIZE: "64G"
      USERNAME: "${WINDOWS_USERNAME:-cgpp}"
      TZ: "Europe/Berlin"
    devices:
      - /dev/kvm
      - /dev/net/tun
    cap_add:
      - NET_ADMIN
    ports:
      - 127.0.0.1:8006:8006
      - 127.0.0.1:3389:3389/tcp
      - 127.0.0.1:3389:3389/udp
      - 127.0.0.1:2222:22/tcp
    volumes:
      - /home/cgpp/.windows:/storage
      - /home/cgpp/Windows:/shared
    restart: unless-stopped
    stop_grace_period: 2m
EOF
  fi

  if [ ! -e "$windows_config/docker-compose.usb.yml" ]; then
    cat >"$windows_config/docker-compose.usb.yml" <<'EOF'
services:
  windows:
    environment:
      ARGUMENTS: "-rtc base=localtime,clock=host,driftfix=slew -chardev serial,id=medtronic,path=/dev/ttyUSB0 -device usb-serial,chardev=medtronic,serial=fa245e596e45ec11ad72d7e6461fcfc8"
    devices:
      - /dev/ttyUSB0:/dev/ttyUSB0
EOF
  fi

  if [ ! -e "$windows_config/.env" ]; then
    printf 'WINDOWS_USERNAME=cgpp\nWINDOWS_PASSWORD=admin\n' >"$windows_config/.env"
    chmod 0600 "$windows_config/.env"
  fi

  if [ "$(id -u)" = 0 ] && id cgpp >/dev/null 2>&1; then
    chown -R cgpp:users "$windows_config" "$home_dir/.windows" "$home_dir/Windows" || true
  fi
}

same_device() {
  [ "$(stat -c '%d' "$1")" = "$(stat -c '%d' "$2")" ]
}

restore_image() {
  local image="" arg home_dir storage dest
  while [ $# -gt 0 ]; do
    arg=$1
    case "$arg" in
      --image)
        image=${2:-}
        [ -n "$image" ] || die "--image needs a path"
        shift 2
        ;;
      --target-root)
        TARGET_ROOT=${2:-}
        [ -n "$TARGET_ROOT" ] || die "--target-root needs a path"
        shift 2
        ;;
      *)
        die "unknown restore option: $arg"
        ;;
    esac
  done

  [ -n "$image" ] || die "restore requires --image PATH"
  [ -f "$image" ] || die "image does not exist: $image"
  [ -s "$image" ] || die "image is empty: $image"

  ensure_config
  home_dir=$(target_home)
  storage="$home_dir/.windows"
  dest="$storage/data.img"

  rm -f "$storage/tmp/win11x64.iso" "$storage/windows.base"
  install -d -m 0755 "$storage/backups/unknown"

  if [ -e "$dest" ] && [ ! -L "$dest" ] && [ "$(stat -c '%i:%d' "$dest")" = "$(stat -c '%i:%d' "$image")" ]; then
    log "data.img already points at the selected image"
  else
    rm -f "$dest"
    if same_device "$storage" "$image" && ln "$image" "$dest" 2>/dev/null; then
      log "hard-linked image to $dest"
    elif cp --reflink=auto --sparse=always "$image" "$dest" 2>/dev/null; then
      log "copied image to $dest"
    else
      rsync --info=progress2 --sparse "$image" "$dest"
      log "rsynced image to $dest"
    fi
  fi

  [ ! -L "$dest" ] || die "$dest must be a real file, not a symlink"
  printf 'windows\n' >"$storage/windows.boot"

  for file in windows.rom windows.vars windows.mac; do
    if [ -f "$(dirname "$image")/$file" ] && [ ! -e "$storage/$file" ]; then
      cp --reflink=auto "$(dirname "$image")/$file" "$storage/$file" 2>/dev/null || cp "$(dirname "$image")/$file" "$storage/$file"
    fi
  done

  if [ "$(id -u)" = 0 ] && id cgpp >/dev/null 2>&1; then
    chown -R cgpp:users "$storage" || true
  fi

  stat -c '%F %s %n' "$dest"
}

compose_args() {
  local home_dir config
  home_dir=$(target_home)
  config="$home_dir/.config/windows"
  printf '%s\0' --env-file "$config/.env" -f "$config/docker-compose.yml"
  if [ "$USB" = 1 ]; then
    printf '%s\0' -f "$config/docker-compose.usb.yml"
  fi
}

docker_compose() {
  local -a args
  mapfile -d '' -t args < <(compose_args)
  docker compose "${args[@]}" "$@"
}

start_windows() {
  parse_common "$@"
  need docker
  ensure_config

  local home_dir storage
  home_dir=$(target_home)
  storage="$home_dir/.windows"
  [ -f "$storage/data.img" ] || die "missing $storage/data.img; run restore first"
  [ ! -L "$storage/data.img" ] || die "$storage/data.img is a symlink; run restore again"
  [ -f "$storage/windows.boot" ] || printf 'windows\n' >"$storage/windows.boot"

  if [ "$USB" = 1 ] && [ ! -e /dev/ttyUSB0 ]; then
    die "USB mode requested but /dev/ttyUSB0 is missing"
  fi

  rm -f "$storage/tmp/win11x64.iso"
  docker rm -f nix-windows >/dev/null 2>&1 || true
  docker_compose up -d

  log "waiting for Windows readiness"
  for _ in $(seq 1 90); do
    if docker logs nix-windows 2>&1 | grep -qi "Windows started successfully"; then
      log "Windows started successfully"
      if [ "$OPEN_RDP" = 1 ] && command -v xfreerdp >/dev/null 2>&1; then
        local user password
        user=$(grep -E '^WINDOWS_USERNAME=' "$home_dir/.config/windows/.env" | cut -d= -f2- || true)
        password=$(grep -E '^WINDOWS_PASSWORD=' "$home_dir/.config/windows/.env" | cut -d= -f2- || true)
        user=${user:-cgpp}
        password=${password:-admin}
        as_user xfreerdp /u:"$user" /p:"$password" /v:127.0.0.1:3389 -grab-keyboard /sound /microphone /clipboard /cert:ignore /title:"Windows VM" /dynamic-resolution || true
      fi
      return 0
    fi
    sleep 2
  done

  log "not ready yet; web console is http://127.0.0.1:8006/"
  docker logs --tail=100 nix-windows 2>&1 || true
  return 1
}

stop_windows() {
  docker rm -f nix-windows >/dev/null 2>&1 || true
  log "stopped nix-windows"
}

status_windows() {
  docker ps -a --filter name=nix-windows --format 'table {{.ID}}\t{{.Image}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}' || true
  if [ -f "$HOME/.windows/data.img" ]; then
    stat -c '%F %s %h %n' "$HOME/.windows/data.img"
  fi
}

find_images() {
  find /run/media /media /mnt /home -xdev -type f -name data.img -size +10G 2>/dev/null | sort
}

tui() {
  need gum
  local choice image
  choice=$(gum choose \
    "Restore Windows image" \
    "Start Windows with USB" \
    "Start Windows without USB" \
    "Stop Windows" \
    "Status" \
    "Logs")
  case "$choice" in
    "Restore Windows image")
      image=$(find_images | gum choose --header "Select data.img")
      restore_image --image "$image"
      ;;
    "Start Windows with USB")
      start_windows --usb
      ;;
    "Start Windows without USB")
      start_windows
      ;;
    "Stop Windows")
      stop_windows
      ;;
    "Status")
      status_windows
      ;;
    "Logs")
      docker logs -f nix-windows
      ;;
  esac
}

cmd=${1:-}
case "$cmd" in
  tui) shift; tui "$@" ;;
  restore) shift; restore_image "$@" ;;
  start) shift; start_windows "$@" ;;
  stop) shift; stop_windows "$@" ;;
  status) shift; status_windows "$@" ;;
  logs) shift; docker logs -f nix-windows ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd" ;;
esac
