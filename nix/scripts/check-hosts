#!/usr/bin/env bash
# Evaluate every host in the flake without building anything.
#
# `nix flake check` covers nixosConfigurations for the current system but
# skips darwinConfigurations, so the Mac is evaluated separately. Evaluation
# is enough to catch the usual breakage (missing files, bad options, modules
# importing things another host doesn't have) and runs fine from Linux/WSL.
#
# Usage: nix/scripts/check-hosts            (from anywhere in the repo)
set -euo pipefail

flake_dir="$(git rev-parse --show-toplevel)/nix"
cd "$flake_dir"

untracked="$(git ls-files --others --exclude-standard -- ..)"
if [ -n "$untracked" ]; then
  echo "error: untracked files are invisible to the flake -- git add them first:" >&2
  echo "$untracked" >&2
  exit 1
fi

noise='is dirty|^$|evaluation warning|trace: warning|deprecated|renamed to/replaced by|hyprland.configType|pointerCursor|legacy default|To silence|To adopt|keep legacy|Please update|^ +$'

echo "==> nix flake check (all nixosConfigurations)"
nix flake check --no-build 2>&1 | grep -vE "$noise" || true
# Re-run quietly for the exit status (grep above swallows it).
nix flake check --no-build >/dev/null 2>&1

echo "==> darwinConfigurations"
for host in $(nix eval --json .#darwinConfigurations --apply builtins.attrNames 2>/dev/null | tr -d '[]"' | tr ',' ' '); do
  printf '    %s ... ' "$host"
  nix eval --raw ".#darwinConfigurations.\"$host\".system.outPath" >/dev/null 2>/tmp/check-hosts-darwin.log \
    && echo ok \
    || { echo FAILED; grep -E '^error' /tmp/check-hosts-darwin.log >&2; exit 1; }
done

echo "==> all hosts evaluate"
