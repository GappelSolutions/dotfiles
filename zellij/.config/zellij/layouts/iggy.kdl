layout {
    cwd "~/dev/nova/IggyPoc/"

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="1-aoe" {
        pane borderless=true command="aoe"
    }

    tab name="2-nvim" {
        pane borderless=true command="nvim"
    }

    tab name="3-tools" {
        pane split_direction="vertical" {
            pane size="58%" split_direction="horizontal" {
                pane command="yazi" {
                    args "~/dev/nova/IggyPoc/"
                }

                pane command="lazydocker"
            }

            pane size="42%" split_direction="horizontal" {
                pane focus=true command="podman-compose" start_suspended=true {
                    args "up" "--build" "-d"
                }

                pane
            }
        }
    }

    tab name="4" { pane; }
    tab name="5" { pane; }
    tab name="6" { pane; }
    tab name="7" { pane; }
    tab name="8" { pane; }
    tab name="9" { pane; }
    tab name="0" { pane; }
}

scrollback_editor "nvim"
default_mode "locked"
