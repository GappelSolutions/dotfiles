{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/assets/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 8,
  "border": true,
  "border_width": 6,
  "border_offset": -1,
  "border_colours": {
    "single": "#84a0c6",
    "stack": "#a093c7",
    "monocle": "#161821",
    "unfocused": "#161821",
    "floating": "#e2a478"
  },
  "monitors": [
    {
      "work_area_offset": {
        "left": 0,
        "top": 0,
        "right": 0,
        "bottom": 0
      },
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "BSP"
        },
        {
          "name": "III",
          "layout": "BSP"
        },
        {
          "name": "IV",
          "layout": "BSP"
        },
        {
          "name": "V",
          "layout": "BSP"
        },
        {
          "name": "VI",
          "layout": "BSP"
        },
        {
          "name": "VII",
          "layout": "BSP"
        },
        {
          "name": "VIII",
          "layout": "BSP"
        },
        {
          "name": "IX",
          "layout": "BSP"
        },
        {
          "name": "X",
          "layout": "BSP"
        }
      ]
    }
  ]
}
