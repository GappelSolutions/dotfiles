{
  "model": "opus",
  "effortLevel": "low",
  "autoCompactWindow": 200000,
  "cleanupPeriodDays": 90,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Skill(skill:deep-research)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "Skill(skill:artifact-design)",
      "Skill(skill:artifact-capabilities)",
      "Skill(skill:artifact-diagramming)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/usage-limit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/usage-limit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-filtered-checks.sh"
          }
        ]
      }
    ]
  }
}
