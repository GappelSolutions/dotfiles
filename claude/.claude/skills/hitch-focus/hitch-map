        raw = ""
        if f.get("file") and Path(f["file"]).is_file():
            text = Path(f["file"]).read_text(errors="replace").splitlines()
            more = [f"… {len(text) - 400} more lines"] if len(text) > 400 else []
            raw = (f'<details><summary>{e(Path(f["file"]).name)}</summary><pre>'
                   + "\n".join(e(t) for t in text[:400] + more) + "</pre></details>")
        rest.append(f'<div class="ef"><b>{e(f["title"])}</b><span>{e(f.get("summary"))}</span>{raw}</div>')
    more = []
    if s["skim"]:
        groups = {}
        for h in s["skim"]:
            g = groups.setdefault((h["path"], kind_label(h)), [0, 0])
            g[0], g[1] = g[0] + h["added"], g[1] + h["removed"]
        rows = "".join(f'<div class="meta">{e(p)} · {e(k)} +{a_} −{r}</div>'
                       for (p, k), (a_, r) in sorted(groups.items(), key=lambda x: (x[0][1], x[0][0])))
        more.append(f'<details><summary>skim: {s["skim_files"]} files generated, moved or reformatted</summary>{rows}</details>')
    if m.get("settled"):
        more.append(f'<details><summary>settled: {len(m["settled"])}</summary>'
                    + "".join(f"<div>{e(x)}</div>" for x in m["settled"]) + "</details>")
    if rest or more:
        out.append('<section class="card runs">' + ("<h3>When it runs</h3>" + "".join(rest) if rest else "")
                   + (f'<div class="more">{"".join(more)}</div>' if more else "") + "</section>")
    page = Path(mp).with_suffix(".html")
    page.write_text("<!doctype html><meta charset=utf-8>" + "\n".join(x for x in out if x))
    return page


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "hunks" and len(args) == 3:
        cmd_hunks(*args)
    elif cmd == "build" and len(args) == 1:
        spec, problems = load(args[0]), []
        for k in ("repo", "base", "head"):
            if not spec.get(k):
                sys.exit(f"{args[0]}: no {k}")
        spec.setdefault("worktree", str(toplevel(spec["repo"])))
        m = build(spec, problems)
        mp = map_path(m["repo"], spec["head"])
        save(m, mp)
        print(mp)
        return report(problems)
    elif cmd == "refresh" and len(args) == 1:
        old, problems = load(args[0]), []
        hunks = diff_files(toplevel(old["repo"]), old["base"], old["head"])
        save(build(regroup(old, hunks), problems, hunks=hunks), Path(args[0]))
        print(args[0])
        return report(problems)
    elif cmd == "live" and len(args) == 1:
        return cmd_live(args[0])
    elif cmd == "check" and len(args) == 1:
        m, problems = load(args[0]), []
        spec = {k: v for k, v in m.items() if k != "blocks"}
        spec["blocks"] = [b for b in m["blocks"] if not b.get("unassigned")]
        build(spec, problems, live=m.get("live", False))
        if not problems:
            print("ok")
        return report(problems)
    elif cmd == "html" and len(args) == 1:
        print(cmd_html(args[0]))
    elif cmd == "flow" and len(args) == 1:
        cmd_flow(args[0])
    elif cmd == "outline" and len(args) == 1:
        cmd_outline(args[0])
    elif cmd == "block" and len(args) == 2:
        cmd_block(*args)
    elif cmd == "file" and len(args) == 2:
        cmd_file(*args)
    elif cmd == "mark" and len(args) == 2:
        cmd_mark(*args)
    elif cmd == "list" and len(args) <= 1:
        cmd_list(*args)
    elif cmd == "path" and 1 <= len(args) <= 2:
        print(map_path(toplevel(args[0]), *args[1:]))
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
