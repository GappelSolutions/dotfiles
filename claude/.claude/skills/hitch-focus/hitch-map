# The loop lines, each from a step back up to its target; on hover a band across the row, and
# the row's own jumps (skips and loops, in and out) drawn bright with the rest faded.
JS = """
const NS = 'http://www.w3.org/2000/svg';
const path = (g, d) => { const p = document.createElementNS(NS, 'path'); p.setAttribute('d', d); g.appendChild(p); };
const edge = (g, x, w, sy, ty) => {
  const d = Math.sign(ty - sy) || 1;
  path(g, `M${w} ${sy} H${x + 4} Q${x} ${sy} ${x} ${sy + 4 * d} V${ty - 4 * d} Q${x} ${ty} ${x + 4} ${ty} H${w}`);
  path(g, `M${w - 5} ${ty - 3.5} L${w} ${ty} L${w - 5} ${ty + 3.5}`);
};
const nums = (r, k) => (r.dataset[k] || '').split(' ').filter(Boolean);
for (const f of document.querySelectorAll('.flow[data-jumps]')) {
  const svg = document.createElementNS(NS, 'svg'), base = document.createElementNS(NS, 'g'), hot = document.createElementNS(NS, 'g');
  const band = document.createElement('div');
  svg.setAttribute('class', 'edges'); hot.setAttribute('class', 'hot'); svg.append(base, hot); f.append(svg);
  band.className = 'band'; band.hidden = true; f.prepend(band);
  const w = () => parseFloat(getComputedStyle(f).getPropertyValue('--gw')) - 4;
  const top = el => el.getBoundingClientRect().top - f.getBoundingClientRect().top;
  const step = n => [...f.querySelectorAll(`[data-n="${n}"]`)].find(r => r.offsetParent);
  const draw = () => {
    base.replaceChildren(); svg.setAttribute('width', w() + 4); svg.setAttribute('height', f.offsetHeight);
    for (const t of f.querySelectorAll('[data-lane]')) if (t.offsetParent)
      for (const s of f.querySelectorAll(`[data-back~="${t.dataset.n}"]`)) edge(base, 3 + +t.dataset.lane * 8, w(), top(s) + 11, top(t) + 11);
  };
  const clear = () => { hot.replaceChildren(); f.classList.remove('hot'); f.querySelectorAll('.tgt').forEach(r => r.classList.remove('tgt')); };
  f.addEventListener('mouseover', ev => {
    const r = ev.target.closest('.r') || ev.target.closest('.if')?.nextElementSibling.querySelector('.r');
    if (!r) return;
    band.hidden = false; band.style.top = top(r) + 'px'; band.style.height = r.offsetHeight + 'px';
    clear();
    const pairs = [...nums(r, 'fwd'), ...nums(r, 'back')].map(n => [r, step(n)]);
    if (r.dataset.n) for (const s of f.querySelectorAll(`[data-fwd~="${r.dataset.n}"],[data-back~="${r.dataset.n}"]`)) pairs.push([s, r]);
    for (const [s, t] of pairs.filter(([s, t]) => t && s.offsetParent)) {
      edge(hot, 3, w(), top(s) + 11, top(t) + 11);
      (t === r ? s : t).classList.add('tgt');
    }
    if (hot.childElementCount) f.classList.add('hot');
  });
  f.addEventListener('mouseleave', () => { band.hidden = true; clear(); });
  f.addEventListener('toggle', draw, true);
  draw();
}
"""


def e(s):
    return html.escape(str(s or ""))


def a(href, inner, title=""):
    """A link out of T3's chat frame."""
    t = f' title="{e(title)}"' if title else ""
    return f'<a href="{e(href)}" target="_blank" rel="noopener"{t}>{inner}</a>'


def pr_link(m, at):
    """T3's PR panel opens at the line only in this form."""
    pin = re.match(r"(.+):(\d+)$", at or "")
    if not (m.get("url") and pin):
        return None
    return f'{m["url"]}#diff-{hashlib.sha256(pin[1].encode()).hexdigest()}R{pin[2]}'


SIGN = {"new": "+", "changed": "~", "gone": "−"}


def row_html(m, r, lane):
    """One row: number and status in the left columns, glyph, the step linked to its line,
    detail, chips, the actor right; a was row struck through under a changed step."""
    if r["kind"] == "fold":
        return (f'<details class="fold"><summary class="r ctx"><span class="mk">⋯</span><span class="tx">{e(r["text"])}</span>'
                f'</summary>{rows_html(m, r["rows"], lane)}</details>')
    attrs = ""
    if r["n"]:
        attrs += f' data-n="{r["n"]}"' + (f' data-lane="{lane[r["n"]]}"' if r["n"] in lane else "")
    for k in ("fwd", "back"):
        if r[k]:
            attrs += f' data-{k}="{" ".join(str(t) for t in r[k])}"'
    link = pr_link(m, r["at"])
    text = a(link, e(r["text"]), r["at"]) if link else f'<span title="{e(r["at"])}">{e(r["text"])}</span>'
    ch = "".join(f'<span class="go" title="skips to step {n}">→ {n}</span>' for n in r["fwd"])
    if r["kind"] == "jump":
        ch += "".join(f'<span class="go" title="loops back to step {n}">↻ {n}</span>' for n in r["back"])
    out = (f'<div class="r {r["change"] or "ctx"} {r["kind"]}"{attrs}>'
           + (f'<span class="no">{r["n"]}</span>' if r["n"] else "")
           + (f'<span class="st {r["change"]}">{SIGN[r["change"]]}</span>' if r["change"] in SIGN and r["kind"] != "jump" else "")
           + (f'<span class="mk">{r["glyph"]}</span>' if r["glyph"] else "")
           + f'<span class="tx">{text if r["text"] else ""}'
           + (f'<span class="dt">{e(r["detail"])}</span>' if r["detail"] else "")
           + (f'<span class="star">★{r["star"]}</span>' if r["star"] else "") + ch + "</span>"
           + (f'<span class="who">{e(r["who"])}</span>' if r["who"] else "") + "</div>")
    if r["was"]:
        out += (f'<div class="r was"><span class="st gone">−</span><span class="mk"></span>'
                f'<span class="tx" title="before">{e(r["was"])}</span></div>')
    return out


def rows_html(m, rows, lane):
    out = []
    for r in rows:
        out.append(row_html(m, r, lane))
        out += [f'<div class="br"><span class="if">{e(br["cond"])}</span><div class="rs">{rows_html(m, br["rows"], lane)}</div></div>'
                for br in r["branches"]]
    return "".join(out)


def flow_html(m, rows):
    fl = [r for r, _ in flat(rows)]
    lane, _, count = lanes(fl)
    jumps = any(r["fwd"] or r["back"] for r in fl)
    gw = f"{max(count, 1) * 8 + 10}px" if jumps else "0px"
    return (f'<div class="flow" style="--gw:{gw}"{" data-jumps" if jumps else ""}>'
            + rows_html(m, rows, lane) + "</div>")


def cmd_html(mp):
    m, done = load(mp), reviewed(mp)
    s = stats(m)
    stars, by_block = focus_stars(m)
    tests = slice_tests(m)
    bare = [b for b in m["blocks"] if not b.get("flow") and not b.get("logic")]
    sliced = [b for b in m["blocks"] if b not in bare]
    num = {b["id"]: i + 1 for i, b in enumerate(sliced)}

    title = (f"#{m['pr']} " if m.get("pr") else "") + (m.get("title") or Path(mp).stem)
    chips = [a(m["url"], f"#{m['pr']}") if m.get("url") and m.get("pr") else "",
             e(f"{len(sliced)} slices") if sliced else "",
             e(f'~{s["read_lines"]} lines · {s["read_files"]} files'),
             e(f'tests hidden: {len(s["tests"])} files') if s["tests"] else "",
             e(f'{m["base_sha"][:7]}..{m["head_sha"][:7]}' + (" + worktree" if m.get("live") else ""))]
    out = [f"<title>{e(title)}</title><style>{CSS}</style>", '<div class="top">',
           f'<p>{e(m.get("intent"))}</p>' if m.get("intent") else "",
           '<div class="chips">' + "".join(f'<span class="chip">{c}</span>' for c in chips if c) + "</div>"]
    if len(sliced) > 1:
        out.append('<div class="lbl">Reading order · what each slice takes and hands on · ★ judgment calls</div><div class="ov">')
        for k, b, frm, ext, gone in overview(sliced):
            st = by_block.get(b["id"], [])
            src = [f'<span title="{e(", ".join(v))}">{j}</span>' for j, v in frm.items()] + [e(t) for t in ext]
            out.append(f'<span class="k{" risk" if st else ""}"><b>{k}</b>{e(b.get("name") or b["title"])}</span>'
                       f'<span>{"".join(f"<span class=star>★{n}</span>" for n, _ in st)}</span>'
                       f'<span class="io">{"← " + " ".join(src) if src else ""}</span>'
                       f'<span class="io">{"↗ " + e(" · ".join(gone)) if gone else ""}</span>')
        out.append("</div>")
        if m.get("order"):
            out.append(f'<div class="why">{e(m["order"])}</div>')
    out += ['<div class="legend"><span>+ new · ~ changed · − removed, struck: what it did before</span>'
            '<span>○ step · ◇ decision · ↗ leaves the process · ■ ends</span>'
            '<span>line on the left: loops back · → n: skips to step n · right: where it runs</span>'
            '<span>★ judgment call · hover a step for its jumps</span></div>', "</div>"]

    if bare:
        label = "changes by file: /hitch-focus slices them" if m.get("auto") else "not in a slice yet"
        out.append(f'<section class="card loose"><div class="hd"><h2>{label}</h2></div>'
                   + "".join(flow_html(m, bare_rows(m, b)) for b in bare) + "</section>")
    for b in sliced:
        cls = " ".join(["card"] + [c for c, on in (("done", b["key"] in done), ("loose", b.get("unassigned"))) if on])
        focus = by_block.get(b["id"], [])
        out.append(f'<section class="{cls}" id="{e(b["id"])}"><div class="hd"><span class="n{" risk" if focus else ""}">{num[b["id"]]}</span>'
                   f'<h2>{e(b["title"])}</h2><span class="meta">{e(slice_meta(m, b))}'
                   f'{" · not in a slice yet" if b.get("unassigned") else ""}{" · ✓ viewed" if b["key"] in done else ""}</span></div>')
        if b.get("what"):
            out.append(f'<div class="what">{e(b["what"])}</div>')
        if ends(b):
            out.append('<div class="ends">' + "".join(f'<span class="pill">{e(x)}</span>' for x in ends(b)) + "</div>")
        out.append(flow_html(m, slice_layout(m, b, stars)))
        if tests.get(b["id"]):
            out.append('<div class="tests"><span>tests</span>' + "".join(
                a(pr_link(m, at) or "#", e(at.rpartition(":")[0].rpartition("/")[2]), at) for at in tests[b["id"]]) + "</div>")
        if focus:
            out.append('<div class="focus"><div class="lbl">Judgment calls · where a reviewer could choose differently</div>')
            for n, f in focus:
                rows = "".join(f"<dt>{label}</dt><dd>{e(f[k])}</dd>" for k, label in
                               (("chosen", "chosen"), ("instead", "instead"), ("tradeoff", "trade-off"),
                                ("look", "look at")) if f.get(k))
                link = pr_link(m, f.get("at"))
                name = e(f.get("at", "").rpartition("/")[2])
                at = a(link, name) if link else name
                door = f' · {e(f["door"])}' if f.get("door") else ""
                out.append(f'<details><summary><span class="star">★{n}</span><span>{e(f["title"])}</span>'
                           f'<span class="meta">{at}{door}</span></summary><dl>{rows}</dl></details>')
            out.append("</div>")
        out.append("</section>")

    rest = []
    for f in m.get("effects", []):
        raw = ""
        if f.get("file") and Path(f["file"]).is_file():
            text = Path(f["file"]).read_text(errors="replace").splitlines()
            more = [f"… {len(text) - 400} more lines"] if len(text) > 400 else []
            raw = (f'<details><summary>{e(Path(f["file"]).name)}</summary><pre>'
                   + "\n".join(e(t) for t in text[:400] + more) + "</pre></details>")
        rest.append(f'<div class="ef"><b>{e(f["title"])}</b><span>{e(f.get("summary"))}</span>{raw}</div>')
    more = []
    if s["skim"]:
        groups = {}
        for h in s["skim"]:
            g = groups.setdefault((h["path"], kind_label(h)), [0, 0])
            g[0], g[1] = g[0] + h["added"], g[1] + h["removed"]
        rows = "".join(f'<div class="meta">{e(p)} · {e(k)} +{a_} −{r}</div>'
                       for (p, k), (a_, r) in sorted(groups.items(), key=lambda x: (x[0][1], x[0][0])))
        more.append(f'<details><summary>skim: {s["skim_files"]} files generated, moved or reformatted</summary>{rows}</details>')
    if m.get("settled"):
        more.append(f'<details><summary>settled: {len(m["settled"])}</summary>'
                    + "".join(f"<div>{e(x)}</div>" for x in m["settled"]) + "</details>")
    if rest or more:
        out.append('<section class="card runs">' + ("<h3>When it runs</h3>" + "".join(rest) if rest else "")
                   + (f'<div class="more">{"".join(more)}</div>' if more else "") + "</section>")
    out.append(f"<script>{JS}</script>")
    page = Path(mp).with_suffix(".html")
    page.write_text("<!doctype html><meta charset=utf-8>" + "\n".join(x for x in out if x))
    return page


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "hunks" and len(args) == 3:
        cmd_hunks(*args)
    elif cmd == "build" and len(args) == 1:
        spec, problems = load(args[0]), []
        for k in ("repo", "base", "head"):
            if not spec.get(k):
                sys.exit(f"{args[0]}: no {k}")
        spec.setdefault("worktree", str(toplevel(spec["repo"])))
        m = build(spec, problems)
        mp = map_path(m["repo"], spec["head"])
        save(m, mp)
        print(mp)
        return report(problems)
    elif cmd == "refresh" and len(args) == 1:
        old, problems = load(args[0]), []
        hunks = diff_files(toplevel(old["repo"]), old["base"], old["head"])
        save(build(regroup(old, hunks), problems, hunks=hunks), Path(args[0]))
        print(args[0])
        return report(problems)
    elif cmd == "live" and len(args) == 1:
        return cmd_live(args[0])
    elif cmd == "check" and len(args) == 1:
        m, problems = load(args[0]), []
        spec = {k: v for k, v in m.items() if k != "blocks"}
        spec["blocks"] = [b for b in m["blocks"] if not b.get("unassigned")]
        build(spec, problems, live=m.get("live", False))
        if not problems:
            print("ok")
        return report(problems)
    elif cmd == "html" and len(args) == 1:
        print(cmd_html(args[0]))
    elif cmd == "flow" and len(args) == 1:
        cmd_flow(args[0])
    elif cmd == "outline" and len(args) == 1:
        cmd_outline(args[0])
    elif cmd == "block" and len(args) == 2:
        cmd_block(*args)
    elif cmd == "file" and len(args) == 2:
        cmd_file(*args)
    elif cmd == "mark" and len(args) == 2:
        cmd_mark(*args)
    elif cmd == "list" and len(args) <= 1:
        cmd_list(*args)
    elif cmd == "path" and 1 <= len(args) <= 2:
        print(map_path(toplevel(args[0]), *args[1:]))
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
