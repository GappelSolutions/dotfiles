# ---------------------------------------------------------------- flow

GUTTER = {"new": "+", "changed": "~", "gone": "-"}


def glyph(st, back=False):
    """A jump loops (↻) when its target comes earlier; a step leaving the process or ending
    the path shows that even when it decides too."""
    if st.get("to") and not st.get("do"):
        return "↻" if back else "→"
    if st.get("kind") in ("out", "stop"):
        return {"out": "⇢", "stop": "■"}[st["kind"]]
    return "◇" if st.get("when") else "○"


def flow_rows(flow, stars, first="", rest="", names=None):
    """A flow as tree rows: {lead, glyph, text, at, change, star}. A check's branches hang
    under it with their condition; a branch without stop or to falls through to the next step."""
    if names is None:
        order = {id(st): n for n, st in enumerate(steps(flow))}
        names = {st["id"]: (st.get("do", st["id"]), order[id(st)]) for st in steps(flow) if st.get("id")}
        names["#order"] = order
    out = []
    for i, st in enumerate(flow):
        target, at_n = names.get(st.get("to"), (st.get("to"), 1 << 30))
        back = at_n <= names["#order"][id(st)]
        text = st.get("do") or target
        if st.get("to") and st.get("do"):
            text += f"  {'↻' if back else '→'} {target}"
        out.append({"lead": first if i == 0 else rest, "glyph": glyph(st, back), "text": text, "at": st.get("at"),
                    "change": st.get("change"), "star": stars.get(st.get("at"))})
        whens = st.get("when", [])
        w = max((len(br.get("if", "")) for br in whens), default=0)
        for j, br in enumerate(whens):
            last = j == len(whens) - 1
            head = rest + ("└ " if last else "├ ") + br.get("if", "").ljust(w) + " "
            cont = rest + ("  " if last else "│ ") + " " * (w + 1)
            if br.get("then"):
                out += flow_rows(br["then"], stars, head, cont, names)
            else:
                out.append({"lead": head, "glyph": "", "text": "on", "at": None, "change": st.get("change"), "star": None})
    return out


def slice_rows(m, b, stars):
    """A slice's flow; without one (no hitch-focus yet, or code no slice holds): its logic,
    else its files, each pinned to its first changed line."""
    if b.get("flow"):
        return flow_rows(b["flow"], stars)
    if b.get("logic"):
        return [{"lead": "", "glyph": "", "text": b["logic"], "at": None, "change": None, "star": None}]
    hunks, files = {h["id"]: h for h in m["hunks"]}, {}
    for i in b["hunks"]:
        if i in hunks:
            files.setdefault(hunks[i]["path"], []).append(hunks[i])
    return [{"lead": "", "glyph": "○", "text": f"{path}  +{sum(h['added'] for h in hs)} −{sum(h['removed'] for h in hs)}",
             "at": f"{path}:{max(hs[0]['new_start'], 1)}", "star": None,
             "change": {"A": "new", "D": "gone"}.get(hs[0]["status"], "changed")} for path, hs in files.items()]


def focus_stars(m):
    """Focus points numbered in map order, by block and by the step line they pin."""
    stars, by_block = {}, {}
    for n, f in enumerate(m.get("focus", []), 1):
        stars.setdefault(f.get("at"), n)
        by_block.setdefault(f.get("block"), []).append((n, f))
    return stars, by_block


def slice_meta(m, b):
    add, rem = block_size(m, b)
    hunks = {h["id"]: h for h in m["hunks"]}
    files = len({hunks[i]["path"] for i in b["hunks"] if i in hunks})
    return f"+{add} −{rem} · {files} file{'s' * (files != 1)}"


def cmd_flow(mp):
    """The map as one buffer of flows (vis): <key>/map.flow, plus map.at with the slice and
    the pinned path:line of every buffer line."""
    m, done = load(mp), reviewed(mp)
    stars, by_block = focus_stars(m)
    s = stats(m)
    title = (f"#{m['pr']} " if m.get("pr") else "") + (m.get("title") or Path(mp).stem)
    lines = [(f"# {title}", "", "")]
    lines += [(f"# {l}", "", "") for l in wrap(m.get("intent", ""), 96)]
    n_sliced = len([b for b in m["blocks"] if b.get("flow") or b.get("logic")])
    top = [(f"{n_sliced} slices, " if n_sliced else "") + f"~{s['read_lines']} lines in {s['read_files']} files"]
    if s["tests"]:
        top.append(f"tests hidden: {len(s['tests'])} files")
    if s["skim"]:
        top.append(f"skim: {s['skim_files']} files")
    top.append(f"{m['base_sha'][:7]}..{m['head_sha'][:7]}" + (" + worktree" if m.get("live") else ""))
    lines += [("# " + " · ".join(top), "", ""),
              ("# gd: code · <Space>d: diff · ]b [b: slices · <Space>v: viewed · <Space>m: refresh", "", "")]
    bare = [b for b in m["blocks"] if not b.get("flow") and not b.get("logic")]
    if bare:
        head = "changes by file: /hitch-focus slices them" if m.get("auto") else "not in a slice yet"
        lines += [("", "", ""), (f"━━ {head}", "", "")]
        for b in bare:
            for r in slice_rows(m, b, stars):
                lines.append((f"{GUTTER.get(r['change'], ' ')}   ○ {r['text']}" + ("  \U000f012c" if b["key"] in done else ""),
                              b["id"], r["at"] or ""))
    for n, b in enumerate([b for b in m["blocks"] if b not in bare], 1):
        mark = "  \U000f012c" if b["key"] in done else ("  ! not in a slice yet" if b.get("unassigned") else "")
        lines += [("", "", ""), (f"━━ {n} {b['title']}   {slice_meta(m, b)}{mark}", b["id"], "")]
        for r in slice_rows(m, b, stars):
            star = f"  \uf005{r['star']}" if r["star"] else ""
            gl = f"{r['glyph']} " if r["glyph"] else ""
            text = [r["text"]] if b.get("flow") else wrap(r["text"], 92)
            for i, t in enumerate(text):
                lines.append((f"{GUTTER.get(r['change'], ' ') if i == 0 else ' '}   {r['lead']}{gl if i == 0 else ''}{t}"
                              f"{star if i == len(text) - 1 else ''}".rstrip(), b["id"], r["at"] or ""))
        for k, f in by_block.get(b["id"], []):
            lines.append((f"    {k} {f['title']}" + (f" · {f['door']}" if f.get("door") else ""), b["id"], f.get("at", "")))
    if m.get("effects"):
        lines += [("", "", ""), ("━━ effects", "", "")]
        for f in m["effects"]:
            for i, l in enumerate(wrap(f"{f['title']}: {f.get('summary', '')}", 92)):
                lines.append((f"    {'⇢' if i == 0 else ' '} {l}", "", ""))
    out = Path(mp).with_suffix("") / "map.flow"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(l for l, _, _ in lines) + "\n")
    out.with_suffix(".at").write_text("\n".join(f"{b}\t{a}" for _, b, a in lines) + "\n")
    print(out)


