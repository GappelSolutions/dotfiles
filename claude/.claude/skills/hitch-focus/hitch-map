#!/usr/bin/env python3
"""PR map for hitch-focus: a diff as semantic blocks, rendered for T3 (HTML) and vis.

  hitch-map hunks <repo> <base> <head>   the diff with an `### <id> <kind>` line over
      every hunk, for the agent that groups them. Kinds the script decides: test
      (hidden), generated, mechanical (whitespace, moved code), binary; `-` = to group.
  hitch-map build <in.json>   merge the agent's groups with the diff, check coverage,
      write the map; prints its path. Exit 1 and the problems when it doesn't hold.
  hitch-map refresh <map>     re-diff after a push: blocks keep the hunks that still
      exist, new ones land in an unassigned block. Exit 1 while one is unassigned.
  hitch-map live <dir|map>    the map of the branch checked out in <dir> over its worktree
      (uncommitted and untracked files too), rebuilt on every call (vis <Space>m). With a
      hitch-focus map: refresh against the worktree. Without: base origin/HEAD, one block
      per file in layer order.
  hitch-map check <map>       coverage and anchors, as build checks them.
  hitch-map html <map>        the slices as cards for T3's chat (html_render), next to the map;
      prints its path. Steps link into T3's PR panel at their line.
  hitch-map flow <map>        the slices as flow trees in one buffer (vis <Space>m), plus
      map.at: the slice and pinned path:line of each of its lines.
  hitch-map outline <map>     one line per block in reading order.
  hitch-map block <map> <id>  one block as a diff buffer; prints its path (vis).
  hitch-map file <map> <path> the head version of <path> to jump to; prints its path.
  hitch-map mark <map> <id>   toggle a block viewed. A block's key is its hunks'
      content, so a push re-opens only the blocks it changed.
  hitch-map list [repo]       maps, newest first (all repos without one).
  hitch-map path <repo> [head]  where the map of <repo>'s branch (or <head>) lives.

<in.json>, written by the hitch-focus agent:
  {repo, base, head, pr?, url?, title?, intent,
   blocks: [{id, title, flow: [step], logic?, hunks: [hunk ids, in reading order], after: [block ids]}],
   focus: [{block, title, at: "path:line", chosen, instead, tradeoff, look, door}],
   effects: [{title, layer, summary, file?}], settled: [text]}
step: {do, at: "path:line", change?: new|changed|gone, kind?: out|stop, id?,
   when?: [{if, then: [step]}], to?: step id}  (hitch-focus SKILL.md: Flow)
Hunk ids hash the hunk's path and lines, not its position: they survive rebases.
Patterns a repo needs beyond the defaults: the git attributes `hitch-test` and
`linguist-generated` (.gitattributes).
"""

import hashlib
import html
import json
import os
import re
import subprocess
import sys
import urllib.parse
from datetime import datetime, timezone
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hitch/map"
CONTEXT = 2
LAYERS = ["contract", "backend", "frontend", "infra", "docs", "other"]
UNTRACKED = 200  # untracked files a live map reads at most

TEST = [
    r"(^|/)(tests?|__tests__|e2e|testing|fixtures|__snapshots__|checks)/",
    r"(^|/)[^/]*-e2e/",
    r"(^|/)[^/]*\.(Unit|Integration|Functional|Architecture|E2E)?Tests?(\.[^/]*)?/",
    r"Tests?\.cs$",
    r"\.(spec|test|e2e-spec)\.[cm]?[jt]sx?$",
    r"(^|/)test_[^/]*\.py$|_test\.(py|go)$",
    r"\.(snap|verified\.\w+|received\.\w+)$",
    r"(^|/)(tsconfig\.spec\.json|jest\.config\.\w+|vitest\.config\.\w+|playwright\.config\.\w+|karma\.conf\.\w+)$",
]
GENERATED = [
    r"\.Designer\.cs$", r"ModelSnapshot\.cs$", r"\.g\.(i\.)?cs$",
    r"(^|/)(generated|rendered|dist)/", r"\.min\.(js|css)$", r"\.map$",
    r"(^|/)(flake|devenv|Cargo|bun|yarn|composer|poetry|Gemfile|packages)\.lock(b)?$",
    r"(^|/)(package-lock\.json|pnpm-lock\.yaml|packages\.lock\.json|go\.sum)$",
]
LAYER_BY_PATH = [
    ("backend", r"\.(cs|csproj|sln|slnx|slnf|props|targets|fs|sql|go|rs|py|java|kt)$|(^|/)appsettings[^/]*\.json$"),
    ("frontend", r"\.([cm]?[jt]sx?|html|s?css|less|vue|svelte)$|(^|/)(package\.json|angular\.json|project\.json|nx\.json)$"),
    ("docs", r"\.(md|adoc|rst|txt)$"),
    ("infra", r"\.(nix|tf|tfvars|hcl|sh|bash|ps1)$|(^|/)(Dockerfile[^/]*|Containerfile|flake\.lock|devenv\.\w+)$"
              r"|(^|/)(infrastructure|deploy|k8s|helm|charts|rendered|ops|machines|modules|inventory|cluster)/"
              r"|azure-pipelines[^/]*\.ya?ml$|\.github/"),
]


def git(repo, *args, check=True):
    p = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, errors="replace")
    if check and p.returncode:
        sys.exit(f"git {' '.join(args)}: {p.stderr.strip()}")
    return p.stdout


def first(patterns, path):
    return any(re.search(p, path) for p in patterns)


def layer_of(path):
    for layer, pattern in LAYER_BY_PATH:
        if re.search(pattern, path):
            return layer
    return "other"


def attrs(repo, head, paths):
    """`hitch-test` / `linguist-generated` per path, as the head commit (None: the worktree) sets them."""
    if not paths:
        return {}
    source = ["--source", head] if head else []
    p = subprocess.run(["git", "-C", str(repo), "check-attr", *source, "--stdin", "-z",
                        "hitch-test", "linguist-generated"],
                       input="\0".join(paths) + "\0", capture_output=True, text=True)
    out, f = {}, p.stdout.split("\0")
    for i in range(0, len(f) - 2, 3):
        if f[i + 2] in ("set", "true"):
            out.setdefault(f[i], set()).add(f[i + 1])
    return out


# ---------------------------------------------------------------- diff

def parse(diff):
    files, f, h = [], None, None
    for line in diff.split("\n"):
        line = line.removesuffix("\r")
        if line.startswith("diff --git "):
            m = re.match(r'diff --git "?a/(.*?)"? "?b/(.*)"?$', line)
            f = {"path": m.group(2), "old_path": m.group(1), "status": "M", "hunks": []}
            files.append(f)
            h = None
        elif f is None:
            continue
        elif h is None and line.startswith(("new file", "deleted file", "rename from", "similarity", "Binary files")):
            if line.startswith("new file"):
                f["status"] = "A"
            elif line.startswith("deleted file"):
                f["status"] = "D"
            elif line.startswith("rename from"):
                f["status"] = "R"
            elif line.startswith("Binary files"):
                f["binary"] = True
        elif line.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@ ?(.*)", line)
            h = {"old_start": int(m[1]), "old_lines": int(m[2] or 1), "new_start": int(m[3]),
                 "new_lines": int(m[4] or 1), "header": m[5].strip(), "lines": []}
            f["hunks"].append(h)
        elif h is not None and line[:1] in (" ", "+", "-", "\\"):
            h["lines"].append(line)
    return files


def diff_files(repo, base, head):
    """Hunks of base...head; head None: the worktree, uncommitted and untracked files included."""
    opts = ["--no-color", "--no-ext-diff", f"-U{CONTEXT}", "--diff-algorithm=histogram"]
    if head:
        raw = git(repo, "diff", *opts, "--find-renames", f"{base}...{head}")
    else:
        raw = git(repo, "diff", *opts, "--find-renames", "--merge-base", base)
        new = [p for p in git(repo, "ls-files", "--others", "--exclude-standard", "-z").split("\0") if p]
        for path in new[:UNTRACKED]:
            raw += git(repo, "diff", *opts, "--no-index", "--", "/dev/null", path, check=False)
    files = parse(raw)
    attr = attrs(repo, head, [f["path"] for f in files])
    seen, hunks = {}, []
    for f in files:
        path, a = f["path"], attr.get(f["path"], set())
        if "hitch-test" in a or first(TEST, path):
            kind = "test"
        elif "linguist-generated" in a or first(GENERATED, path):
            kind = "generated"
        elif f.get("binary"):
            kind = "binary"
        else:
            kind = None
        units = f["hunks"] or [{"old_start": 0, "old_lines": 0, "new_start": 0, "new_lines": 0, "header": "",
                                "lines": [], "whole": "binary" if f.get("binary") else "rename"}]
        for u in units:
            key = hashlib.sha1((path + "\n" + "\n".join(u["lines"]) + u.get("whole", "")).encode()).hexdigest()[:7]
            seen[key] = seen.get(key, 0) + 1
            hid = key if seen[key] == 1 else f"{key}-{seen[key]}"
            hk, why = kind, None
            if hk is None and u.get("whole") == "rename":
                hk, why = "mechanical", "renamed, unchanged"
            hunks.append({"id": hid, "path": path, "old_path": f["old_path"], "status": f["status"],
                          "layer": layer_of(path), "kind": hk, "why": why,
                          **{k: u[k] for k in ("old_start", "old_lines", "new_start", "new_lines", "header", "lines")},
                          "added": sum(l.startswith("+") for l in u["lines"]),
                          "removed": sum(l.startswith("-") for l in u["lines"])})
    mechanical(hunks)
    return hunks


def mechanical(hunks):
    """Whitespace-only hunks, and code moved unchanged: one other hunk holds all of its lines."""
    def changed(h, sign):
        return [l[1:].strip() for l in h["lines"] if l.startswith(sign) and l[1:].strip()]
    sides = {h["id"]: (set(changed(h, "+")), set(changed(h, "-"))) for h in hunks}

    def counterpart(lines, side, own):
        return any(lines <= s[side] for hid, s in sides.items() if hid != own)
    for h in hunks:
        if h["kind"]:
            continue
        add, rem = changed(h, "+"), changed(h, "-")
        if add and add == rem:
            h["kind"], h["why"] = "mechanical", "whitespace only"
            continue
        add_l, rem_l = {l for l in add if len(l) > 3}, {l for l in rem if len(l) > 3}
        if len(add_l) + len(rem_l) < 3 or (add_l and rem_l):
            continue
        if counterpart(add_l, 1, h["id"]) if add_l else counterpart(rem_l, 0, h["id"]):
            h["kind"], h["why"] = "mechanical", "moved"


def resolve(repo, ref):
    return git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}").strip()


def toplevel(repo):
    return Path(git(repo, "rev-parse", "--show-toplevel").strip())


def repo_name(repo):
    common = Path(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    return (common.parent if common.name == ".git" else common).name.removesuffix(".git")


def map_path(repo, head="HEAD"):
    ref = head if head != "HEAD" else git(repo, "rev-parse", "--abbrev-ref", "HEAD").strip()
    if ref == "HEAD":
        ref = resolve(repo, "HEAD")[:12]
    ref = re.sub(r"^(refs/)?(remotes/)?origin/|^refs/heads/", "", ref)
    return STATE / repo_name(repo) / (re.sub(r"[^\w.-]+", "_", ref) + ".json")


# ---------------------------------------------------------------- map

AUTO = {"test": "Tests", "generated": "Generated", "mechanical": "Mechanical", "binary": "Binary"}


def block_key(block):
    return hashlib.sha1(" ".join(sorted(block["hunks"])).encode()).hexdigest()[:10]


def assemble(spec, hunks, problems):
    by_id = {h["id"]: h for h in hunks}
    owner, blocks = {}, []
    for b in spec.get("blocks", []):
        if not b.get("id") or not b.get("title"):
            problems.append(f"block without id or title: {json.dumps(b)[:80]}")
            continue
        b = {"logic": "", "after": [], **b, "hunks": list(b.get("hunks", []))}
        b.pop("layer", None)
        for hid in b["hunks"]:
            if hid not in by_id:
                problems.append(f"{b['id']}: no hunk {hid} in the diff")
            elif hid in owner:
                problems.append(f"hunk {hid} in {owner[hid]} and {b['id']}")
            else:
                owner[hid] = b["id"]
                if by_id[hid]["kind"] == "test":
                    problems.append(f"{b['id']}: hunk {hid} is a test ({by_id[hid]['path']}): tests stay out")
        blocks.append(b)
    ids = {b["id"] for b in blocks}
    for b in blocks:
        check_flow(b, problems)
        for a in b["after"]:
            if a not in ids:
                problems.append(f"{b['id']}: after {a}, no such block")
    loose = [h["id"] for h in hunks if h["id"] not in owner and not h["kind"]]
    if loose:
        blocks.insert(0, {"id": "NEW", "title": "Not in any block", "logic": "", "after": [],
                          "hunks": loose, "unassigned": True})
        problems.append(f"{len(loose)} hunk(s) in no block: {' '.join(loose)}")
    for b in blocks:
        b["key"] = block_key(b)
    return blocks


CHANGES = ("new", "changed", "gone")
KINDS = ("out", "stop")


def steps(flow):
    """Every step of a flow, branches included, in reading order."""
    for st in flow:
        yield st
        for br in st.get("when", []):
            yield from steps(br.get("then", []))


def check_flow(b, problems):
    flow = b.get("flow", [])
    ids = [st["id"] for st in steps(flow) if st.get("id")]
    for st in steps(flow):
        what = f"{b['id']} step {(st.get('do') or st.get('to') or '?')!r}"
        if not st.get("do") and not st.get("to"):
            problems.append(f"{what}: neither do nor to")
        if st.get("change") not in (None, *CHANGES):
            problems.append(f"{what}: change {st['change']!r}, not one of {', '.join(CHANGES)}")
        if st.get("kind") not in (None, *KINDS):
            problems.append(f"{what}: kind {st['kind']!r}, not one of {', '.join(KINDS)}")
        if st.get("to") and st["to"] not in ids:
            problems.append(f"{what}: to {st['to']}, no step with that id")
        for br in st.get("when", []):
            if not br.get("if"):
                problems.append(f"{what}: a branch without if")
    if len(ids) != len(set(ids)):
        problems.append(f"{b['id']}: step ids repeat")


def anchors(m, problems):
    """Every focus point names a block, and it and every flow step a line that exists in the
    head version."""
    ids = {b["id"] for b in m["blocks"]}
    pins = []
    for f in m.get("focus", []):
        if f.get("block") not in ids:
            problems.append(f"focus {f.get('title')!r}: no block {f.get('block')}")
        pins.append((f"focus {f.get('title')!r}", f.get("at")))
    for b in m["blocks"]:
        pins += [(f"{b['id']} step {st.get('do')!r}", st["at"]) for st in steps(b.get("flow", []))
                 if st.get("at") and st.get("change") != "gone"]
    texts = {}
    for what, pin in pins:
        at = re.match(r"(.+):(\d+)$", pin or "")
        if not at:
            problems.append(f"{what}: at {pin!r} is not path:line")
            continue
        if at[1] not in texts:
            if m.get("live"):
                src = Path(m.get("worktree") or m["repo"]) / at[1]
                texts[at[1]] = src.read_text(errors="replace") if src.is_file() else ""
            else:
                texts[at[1]] = git(m["repo"], "show", f"{m['head_sha']}:{at[1]}", check=False)
        text = texts[at[1]]
        if not text:
            problems.append(f"{what}: {at[1]} not in {m['head_sha'][:7]}")
        elif int(at[2]) > text.count("\n") + 1:
            problems.append(f"{what}: {at[1]} has no line {at[2]}")


def order(blocks):
    """Reading order: `after` first, else as given; unassigned on top."""
    done, out, by = set(), [], {b["id"]: b for b in blocks}

    def visit(b, stack=()):
        if b["id"] in done or b["id"] in stack:
            return
        for a in b.get("after", []):
            if a in by:
                visit(by[a], stack + (b["id"],))
        done.add(b["id"])
        out.append(b)
    for b in blocks:
        visit(b)
    return out


def build(spec, problems, live=False, hunks=None):
    """live: head is the worktree (HEAD plus what isn't committed)."""
    repo = toplevel(spec["repo"])
    head = "HEAD" if live else spec["head"]
    base_sha = git(repo, "merge-base", spec["base"], head).strip()
    head_sha = resolve(repo, head)
    if hunks is None:
        hunks = diff_files(repo, spec["base"], None if live else head)
    m = {k: v for k, v in spec.items() if k not in ("blocks",)}
    m.update(repo=str(repo), base_sha=base_sha, head_sha=head_sha, live=live,
             built=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), hunks=hunks)
    m["blocks"] = order(assemble(spec, hunks, problems))
    anchors(m, problems)
    return m


def regroup(old, hunks):
    """The spec of an old map over new hunks: blocks keep the hunks that still exist."""
    spec = {k: v for k, v in old.items() if k not in ("hunks", "base_sha", "head_sha", "built", "live")}
    ids = {h["id"] for h in hunks}
    spec["blocks"] = [{**b, "hunks": [i for i in b["hunks"] if i in ids]}
                      for b in old["blocks"] if not b.get("unassigned")]
    spec["blocks"] = [b for b in spec["blocks"] if b["hunks"]]
    spec["focus"] = [f for f in old.get("focus", []) if any(b["id"] == f["block"] for b in spec["blocks"])]
    return spec


def by_file(hunks):
    """Blocks without an agent: one per file, in layer order."""
    files = {}
    for h in hunks:
        if not h["kind"]:
            files.setdefault(h["path"], []).append(h)
    paths = sorted(files, key=lambda p: (LAYERS.index(files[p][0]["layer"]), p))
    return [{"id": f"B{i}", "title": p, "hunks": [h["id"] for h in files[p]]}
            for i, p in enumerate(paths, 1)]


def default_base(repo):
    head = git(repo, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD", check=False).strip()
    for ref in (head, "origin/main", "origin/master", "main", "master"):
        if ref and git(repo, "rev-parse", "-q", "--verify", f"{ref}^{{commit}}", check=False).strip():
            return ref
    return "HEAD"


def cmd_live(arg):
    """The map of the branch checked out in <arg> (a dir, or a live map) over its worktree."""
    if arg.endswith(".json"):
        mp, old = Path(arg), load(arg)
        if not old.get("live"):
            print(mp)
            return 0
        repo = toplevel(old.get("worktree") or old["repo"])
    else:
        repo = toplevel(arg)
        mp = map_path(repo)
        old = load(mp) if mp.exists() else None
    problems = []
    if old and not old.get("auto"):
        hunks = diff_files(repo, old["base"], None)
        spec = regroup(old, hunks)
        # code no block holds yet: one unassigned block per file, on top
        held = {i for b in spec["blocks"] for i in b["hunks"]}
        new = by_file([h for h in hunks if h["id"] not in held])
        spec["blocks"] = [{**b, "id": "N" + b["id"][1:], "unassigned": True} for b in new] + spec["blocks"]
    else:
        base = old["base"] if old else default_base(repo)
        hunks = diff_files(repo, base, None)
        branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD").strip()
        spec = {"repo": str(repo), "worktree": str(repo), "base": base, "head": "HEAD", "auto": True,
                "title": f"{branch} vs {base}, by file (no hitch-focus map)", "blocks": by_file(hunks)}
    save(build(spec, problems, live=True, hunks=hunks), mp)
    print(mp)
    return report(problems)


def load(path):
    return json.loads(Path(path).read_text())


def reviewed_path(mp):
    return Path(mp).with_suffix(".reviewed")


def reviewed(mp):
    p = reviewed_path(mp)
    return set(p.read_text().split()) if p.exists() else set()


def save(m, mp):
    mp.parent.mkdir(parents=True, exist_ok=True)
    mp.write_text(json.dumps(m, indent=1))


def report(problems):
    for p in problems:
        print(f"✗ {p}", file=sys.stderr)
    return 1 if problems else 0


# ---------------------------------------------------------------- text

def kind_label(h):
    return h["kind"] + (f" ({h['why']})" if h.get("why") else "") if h["kind"] else "-"


def cmd_hunks(repo, base, head):
    out, last = [], None
    for h in diff_files(toplevel(repo), base, head):
        if h["path"] != last:
            out.append(f"\n=== {h['path']}" + (f" (from {h['old_path']})" if h["status"] == "R" else "")
                       + f" [{h['status']} {h['layer']}]")
            last = h["path"]
        out.append(f"### {h['id']} {kind_label(h)}")
        if h["kind"] or not h["lines"]:
            out.append(f"    (+{h['added']} -{h['removed']}, body omitted)")
            continue
        out.append(f"@@ -{h['old_start']},{h['old_lines']} +{h['new_start']},{h['new_lines']} @@ {h['header']}".rstrip())
        out.extend(h["lines"])
    print("\n".join(out).lstrip("\n"))


def stats(m):
    hunks = {h["id"]: h for h in m["hunks"]}
    tests = sorted({h["path"] for h in m["hunks"] if h["kind"] == "test"})
    skim = [h for h in m["hunks"] if h["kind"] and h["kind"] != "test"]
    read = [hunks[i] for b in m["blocks"] for i in b["hunks"] if i in hunks]
    return {
        "blocks": len([b for b in m["blocks"] if not b.get("unassigned")]),
        "read_lines": sum(h["added"] + h["removed"] for h in read),
        "read_files": len({h["path"] for h in read}),
        "skim": skim, "skim_files": len({h["path"] for h in skim}),
        "tests": tests,
    }


def block_size(m, b):
    hunks = {h["id"]: h for h in m["hunks"]}
    hs = [hunks[i] for i in b["hunks"] if i in hunks]
    return sum(h["added"] for h in hs), sum(h["removed"] for h in hs)


def layer_lines(m, b):
    """The projects a slice runs through: changed lines per layer, in layer order."""
    hunks, lines = {h["id"]: h for h in m["hunks"]}, {}
    for i in b["hunks"]:
        if i in hunks:
            h = hunks[i]
            lines[h["layer"]] = lines.get(h["layer"], 0) + h["added"] + h["removed"]
    return [(l, lines[l]) for l in LAYERS if l in lines]


def cmd_outline(mp):
    m, done = load(mp), reviewed(mp)
    focus = {}
    for f in m.get("focus", []):
        focus[f["block"]] = focus.get(f["block"], 0) + 1
    for b in m["blocks"]:
        add, rem = block_size(m, b)
        mark = "󰄬" if b["key"] in done else ("!" if b.get("unassigned") else "·")
        star = f" {focus[b['id']]}" if b["id"] in focus else ""
        layers = " ".join(l for l, _ in layer_lines(m, b))
        print(f"{b['id']} {mark} {b['title']}{star}  +{add} -{rem}  {layers}")


def block_text(m, b, done):
    hunks = {h["id"]: h for h in m["hunks"]}
    blocks = m["blocks"]
    pos = next(i for i, x in enumerate(blocks) if x["id"] == b["id"])
    add, rem = block_size(m, b)
    layers = ", ".join(f"{l} {n}" for l, n in layer_lines(m, b))
    out = [f"# {b['id']} {b['title']}   {pos + 1}/{len(blocks)}  +{add} -{rem}  · {layers}"
           + ("  󰄬 viewed" if b["key"] in done else "")]
    if b.get("logic"):
        out += [f"# {l}" for l in wrap(b["logic"], 96)]
    if b.get("after"):
        out.append(f"# after: {', '.join(b['after'])}")
    for f in m.get("focus", []):
        if f.get("block") == b["id"]:
            out.append(f"#  {f['title']} · {f['at']}")
            for k, label in (("chosen", "chosen"), ("instead", "instead"), ("tradeoff", "trade-off"),
                             ("look", "look at")):
                if f.get(k):
                    out += [f"#   {label}: {l}" if i == 0 else f"#     {l}" for i, l in enumerate(wrap(f[k], 88))]
            if f.get("door"):
                out.append(f"#   {f['door']}")
    out.append("# gd/Enter: open in the code · ]b [b: next/prev slice · <Space>v: viewed · <Space>m: the flow")
    last = None
    for hid in b["hunks"]:
        h = hunks.get(hid)
        if not h:
            continue
        if h["path"] != last:
            out += ["", f"diff --git a/{h['old_path']} b/{h['path']}",
                    f"--- {'/dev/null' if h['status'] == 'A' else 'a/' + h['old_path']}",
                    f"+++ {'/dev/null' if h['status'] == 'D' else 'b/' + h['path']}"]
            last = h["path"]
        if h["lines"]:
            out.append(f"@@ -{h['old_start']},{h['old_lines']} +{h['new_start']},{h['new_lines']} @@ {h['header']}".rstrip())
            out += h["lines"]
        else:
            out.append(f"# {kind_label(h)}")
    return "\n".join(out) + "\n"


def wrap(text, width):
    words, lines, cur = text.split(), [], ""
    for w in words:
        if cur and len(cur) + 1 + len(w) > width:
            lines.append(cur)
            cur = w
        else:
            cur = f"{cur} {w}".strip()
    return lines + ([cur] if cur else [])


def cmd_block(mp, bid):
