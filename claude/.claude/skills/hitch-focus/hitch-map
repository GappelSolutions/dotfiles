def e(s):
    return html.escape(str(s or ""))


def a(href, inner, title=""):
    """A link out of T3's chat frame."""
    t = f' title="{e(title)}"' if title else ""
    return f'<a href="{e(href)}" target="_blank" rel="noopener"{t}>{inner}</a>'


def pr_link(m, at):
    """T3's PR panel opens at the line only in this form."""
    pin = re.match(r"(.+):(\d+)$", at or "")
    if not (m.get("url") and pin):
        return None
    return f'{m["url"]}#diff-{hashlib.sha256(pin[1].encode()).hexdigest()}R{pin[2]}'


TAG = {"changed": "changed", "gone": "removed"}  # new: the green marker says it, most steps are


def step_html(m, text, at, change, cls, star, extra=""):
    """One node on the rail: marker, text (linked to its line), tag, focus star."""
    link = pr_link(m, at)
    tx = a(link, e(text), at) if link else f'<span title="{e(at)}">{e(text)}</span>'
    tag = f'<span class="tag">{TAG[change]}</span>' if change in TAG else ""
    st = f'<span class="star">★{star}</span>' if star else ""
    return (f'<li class="s {change or "ctx"} {cls}"><span class="mk"></span><span class="tx">{tx}</span>'
            f'{tag}{st}{extra}</li>')


def flow_html(m, flow, stars, names=None):
    """A flow as nodes on a rail; a decision's branches as lanes under it, each with its
    condition, falling through to the next step unless they stop or jump."""
    if names is None:
        order = {id(st): n for n, st in enumerate(steps(flow))}
        names = {st["id"]: (st.get("do", st["id"]), order[id(st)]) for st in steps(flow) if st.get("id")}
        names["#order"] = order
    out = []
    for st in flow:
        target, at_n = names.get(st.get("to"), (st.get("to"), 1 << 30))
        back = at_n <= names["#order"][id(st)]
        if st.get("to") and not st.get("do"):
            g = "↻" if back else "→"
            out.append(f'<li class="s jump"><span class="mk"></span><span class="tx">{g} '
                       f'{"back to" if back else "on to"} <i>{e(target)}</i></span></li>')
            continue
        kind = st.get("kind") or ("dec" if st.get("when") else "")
        text = st.get("do", "")
        if st.get("to"):
            text += f"  {'↻ back to' if back else '→ on to'} {target}"
        lanes = ""
        if st.get("when"):
            lanes = '<div class="brs">' + "".join(
                f'<div class="br"><span class="if">{e(br.get("if"))}</span>'
                + (f'<ol class="fl">{flow_html(m, br["then"], stars, names)}</ol>' if br.get("then") else "<span></span>")
                + "</div>" for br in st["when"]) + "</div>"
        out.append(step_html(m, text, st.get("at"), st.get("change"), kind, stars.get(st.get("at")), lanes))
    return "".join(out)


def bare_html(m, b, stars):
    """No flow: the logic line, else one node per file."""
    if b.get("logic"):
        return f'<ol class="fl">{step_html(m, b["logic"], None, None, "", None)}</ol>'
    return '<ol class="fl">' + "".join(step_html(m, r["text"], r["at"], r["change"], "", None)
                                       for r in slice_rows(m, b, stars)) + "</ol>"


