#!/usr/bin/env bash
# Mechanic slots shared by every hitch-tower and hitch-jury session on this
# machine: parallel mechanics burn the 5h limit in bursts.
#   hitch-slot take <task-id>  block until a slot is free, then hold it. Run it
#       in the background: the harness wakes the session when it exits.
#   hitch-slot free <task-id>  release the Task's slot.
#   hitch-slot list            the held slots: "<task-id> <age in minutes>".
# HITCH_MECHANICS slots (default 2). A slot older than 3h is stale and free:
# a session died without freeing it.
set -euo pipefail

dir="${XDG_STATE_HOME:-$HOME/.local/state}/hitch/slots"
max="${HITCH_MECHANICS:-2}"
mkdir -p "$dir"

held() {
  find "$dir" -maxdepth 1 -type f -name 'task-*' -mmin -180 | wc -l
}

case "${1:-}" in
  take)
    [[ -n "${2:-}" ]] || { echo "usage: hitch-slot take <task-id>" >&2; exit 2; }
    find "$dir" -maxdepth 1 -type f -name 'task-*' -mmin +180 -delete
    while :; do
      # shellcheck disable=SC2016  # expands in the inner bash
      got=$(flock "$dir/.lock" bash -c '
        f="$1/task-$2"
        if [[ -e "$f" ]] || (( $(find "$1" -maxdepth 1 -type f -name "task-*" -mmin -180 | wc -l) < $3 )); then
          touch "$f"; echo yes
        fi' _ "$dir" "$2" "$max")
      [[ "$got" == yes ]] && { echo "slot: $2 ($(held)/$max)"; exit 0; }
      sleep 30
    done
    ;;
  free)
    [[ -n "${2:-}" ]] || { echo "usage: hitch-slot free <task-id>" >&2; exit 2; }
    rm -f "$dir/task-$2"
    ;;
  list)
    now=$(date +%s)
    for f in "$dir"/task-*; do
      [[ -e "$f" ]] || continue
      echo "${f##*/task-} $(( (now - $(stat -c %Y "$f")) / 60 ))"
    done
    ;;
  *)
    sed -n '2,9p' "$0" >&2; exit 2
    ;;
esac
